{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Server",
      "type": "shell",
      "command": "cd server && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*",
          "line": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*listening.*",
          "endsPattern": ".*ready.*"
        }
      }
    },
    {
      "label": "Start Client",
      "type": "shell",
      "command": "cd client && npm start",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": ".*",
          "line": 0
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*webpack compiled.*",
          "endsPattern": ".*ready.*"
        }
      }
    },
    {
      "label": "Install Dependencies",
      "type": "shell",
      "command": "cd server && npm install && cd .. && cd client && npm install",
      "problemMatcher": []
    }
  ]
}
